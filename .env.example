# CareBridge Environment Configuration Template
# Copy this file to .env and replace placeholder values

# Optional external OpenAI-compatible LLM endpoint
# If left empty, CareBridge automatically runs offline in deterministic rule mode
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Optional frontend API origin override (defaults to http://localhost:8001)
VITE_API_URL=http://localhost:8001
